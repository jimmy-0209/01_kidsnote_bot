{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "web_app.py",
          "scheduler.py",
          "users_store.py",
          "run_history_store.py",
          "discovery_request_store.py",
          "crypto_utils.py",
          "google_oauth.py",
          "kakao_oauth.py",
          "templates/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
